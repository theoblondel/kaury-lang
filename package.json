{
  "name": "@kaury/cli",
  "version": "0.3.0",
  "main": "dist/core.js",
  "scripts": {
    "build": "node scripts/build.mjs && tsx scripts/editor.ts",
    "test": "tsx --test tests/*.test.ts",
    "kaury": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "measure": "node scripts/measure.mjs",
    "site": "tsx scripts/site-prepare.ts && tsx src/cli/index.ts build site/site.kaury --lang en",
    "site:dev": "tsx scripts/site-prepare.ts && tsx src/cli/index.ts dev site/site.kaury --lang en",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "language",
    "web",
    "3d",
    "three",
    "immersive",
    "compiler",
    "website",
    "seo",
    "threejs",
    "static-site",
    "ssg",
    "lighthouse",
    "llms",
    "ai"
  ],
  "author": "Kaury Studio (https://kaury.studio)",
  "license": "MIT",
  "description": "Kaury — the language for immersive websites. Logic, structure, style and 3D in a single file.",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "lottie-web": "^5.13.0",
    "marked": "^18.1.0",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "bin": {
    "kaury": "bin/kaury.js"
  },
  "exports": {
    ".": "./dist/core.js",
    "./runtime": "./src/runtime/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "docs",
    "LICENSE",
    "README.md",
    "!dist/*.map"
  ],
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://kaury.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theoblondel/kaury-lang.git"
  },
  "bugs": {
    "url": "https://github.com/theoblondel/kaury-lang/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
