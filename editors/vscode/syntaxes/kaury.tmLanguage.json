{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kaury",
  "scopeName": "source.kaury",
  "patterns": [
    {
      "name": "comment.line.double-slash.kaury",
      "match": "//.*$"
    },
    {
      "include": "#text"
    },
    {
      "name": "constant.other.color.kaury",
      "match": "#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})\\b"
    },
    {
      "name": "constant.numeric.kaury",
      "match": "-?\\b\\d+(?:\\.\\d+)?(?:px|rem|em|%|vh|vw|ms|s|deg|fr|/s)?"
    },
    {
      "name": "constant.language.kaury",
      "match": "(?<![\\w-])(true|false|none|vrai|faux|rien)(?![\\w-])"
    },
    {
      "match": "^\\s*(component|composant)\\s+([A-Z][\\w-]*)",
      "captures": {
        "1": {
          "name": "storage.type.kaury"
        },
        "2": {
          "name": "entity.name.type.kaury"
        }
      }
    },
    {
      "match": "^\\s*(function|fonction)\\s+([\\p{L}_][\\w-]*)",
      "captures": {
        "1": {
          "name": "storage.type.kaury"
        },
        "2": {
          "name": "entity.name.function.kaury"
        }
      }
    },
    {
      "name": "keyword.control.kaury",
      "match": "(?<![\\w-])(javascript|continue|fonction|function|retourne|attends|bascule|exporte|importe|arrete|depuis|erreur|essaie|export|import|return|toggle|aller|alors|await|break|catch|close|comme|const|ferme|ouvre|sinon|state|while|dans|else|etat|from|goto|open|pour|puis|soit|tant|then|wait|css|for|let|try|as|de|fn|go|if|in|js|si)(?![\\w-])"
    },
    {
      "name": "storage.type.kaury",
      "match": "(?<![\\w-])(composant|component|site|page)(?![\\w-])"
    },
    {
      "name": "entity.name.tag.kaury",
      "match": "^\\s*(alternates|formulaire|ordinateur|personnage|separateur|sous-titre|traduction|transition|alternate|animation|character|enveloppe|checkbox|children|couleurs|espaceur|hreflang|language|lighting|markdown|subtitle|tablette|textarea|adresse|colonne|contenu|desktop|details|divider|element|favicon|integre|lumiere|polices|section|wrapper|bouton|button|camera|colors|column|deplie|entete|footer|grille|header|iframe|langue|mobile|object|police|select|spacer|tablet|audio|boite|carte|champ|choix|embed|field|fonts|icone|image|input|liens|light|ligne|links|liste|model|objet|scene|sound|style|texte|title|titre|video|base|card|case|font|form|grid|head|icon|item|lang|lien|link|list|logo|menu|pied|slot|tete|text|zone|box|nav|row|seo|son|url|md)(?![\\w-])"
    },
    {
      "name": "support.function.immersion.kaury",
      "match": "(?<![\\w-])(soft-motion|chargement|defilement|personnage|character|parallaxe|lighting|parallax|une-fois|balance|follows|inverse|lumiere|reverse|bottom|boucle|camera|depuis|droite|enters|flotte|follow|gauche|object|rapide|rotate|scroll|smooth|souris|survol|tourne|audio|click|douce|enter|entre|float|fondu|hover|lente|light|model|mouse|objet|pulse|right|saute|scene|sound|clic|doux|down|fade|fast|fois|from|haut|joue|jump|left|lent|load|loop|once|play|says|slow|spin|suit|sway|turn|zoom|bas|dit|say|son|top|au|de|on|up|x|y|z)(?![\\w-])"
    },
    {
      "name": "entity.name.type.component.kaury",
      "match": "^\\s*[A-Z][\\w-]*"
    },
    {
      "name": "keyword.operator.kaury",
      "match": "->|==|!=|<=|>=|\\+=|-=|\\*=|/=|\\.\\.|[+*/%<>=]|(?<![\\w-])(and|or|not|et|ou|non)(?![\\w-])"
    }
  ],
  "repository": {
    "text": {
      "name": "string.quoted.double.kaury",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.kaury",
          "match": "\\."
        },
        {
          "name": "meta.embedded.kaury",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.kaury"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.kaury"
            }
          },
          "patterns": [
            {
              "include": "source.kaury"
            }
          ]
        }
      ]
    }
  }
}
