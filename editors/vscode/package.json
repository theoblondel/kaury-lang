{
  "name": "kaury",
  "displayName": "Kaury",
  "description": "Kaury, the language for immersive websites: highlighting, live errors, completion, hover help.",
  "version": "0.2.0",
  "publisher": "kaury-studio",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:kaury"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kaury",
        "aliases": [
          "Kaury",
          "kaury"
        ],
        "extensions": [
          ".kaury"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kaury",
        "scopeName": "source.kaury",
        "path": "./syntaxes/kaury.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kaury",
        "path": "./snippets.json"
      }
    ]
  },
  "scripts": {
    "prepare": "node ../../scripts/build.mjs && node -e \"require('fs').copyFileSync('../../dist/core.js','core.js')\""
  }
}
