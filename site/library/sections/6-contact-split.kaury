// Contact, split · luxury
site "Contact split"
  colors ink #1A1714, paper #F3EEE6, clay #B5502E
  fonts "Satoshi", "Gambetta"
  style background paper, color ink

style emphasis
  italic, color clay

style info
  gap 4
  text opacity 0.7

page "/"
  section contact
    grid columns 1 1, gap 64
      tablet columns 1
      column gap 28
        title "Say *hello*.", font "titles", weight 400, size 88, tracking -3
        column info
          text "Studio", uppercase, tracking 3, size 12
          text "Rue du Lac 12, 1800 Vevey"
        column info
          text "Write", uppercase, tracking 3, size 12
          text "hello@atelier.ch"
        column info
          text "Call", uppercase, tracking 3, size 12
          text "+41 21 000 00 00"
      column gap 14
        form -> sent = true
          field name "Your name", required, label "Name"
          field email "you@example.com", type email, required, label "Email"
          textarea message "Tell us about your project", required, label "Project"
          button "Send the message", large, background ink, color paper, radius 0
        if sent
          text "Thank you, we answer within a day.", color clay
