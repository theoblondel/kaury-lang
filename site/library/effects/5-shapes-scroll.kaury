// 3D on scroll · immersive
// height 520
site "3D on scroll"
  colors night #0B0A14, orange #FF6A2B, violet #7B5CFF, mint #4DDFA8
  fonts "Satoshi", "Clash Display"
  style background night, color white

page "/"
  scene shapes, fullscreen, center, immediate, particles dust
    light neon
    camera follows mouse
    object "torus", color violet, metal, size 0.9, position -2.4 0.6 0
      spin on scroll
      float
    object "gem", glass, color mint, size 0.7, position 2.3 0.9 -1
      spin 40/s
      float 0.6
    object "capsule", color orange, matte, size 0.6, position 1.6 -1.3 0
      spin slow
    title "Shapes, *free*.", size 92, center, tracking -3
    text "Sphere, cube, torus, knot, gem… no model to load.", color #FFFFFFAA, center
