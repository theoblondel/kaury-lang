{
  "name": "kaury",
  "displayName": "Kaury",
  "description": "Le langage des sites immersifs : coloration, erreurs en direct, complétion.",
  "version": "0.1.0",
  "publisher": "kaury-studio",
  "license": "MIT",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages", "Linters", "Snippets"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:kaury"],
  "contributes": {
    "languages": [{
      "id": "kaury",
      "aliases": ["Kaury", "kaury"],
      "extensions": [".kaury"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{ "language": "kaury", "scopeName": "source.kaury", "path": "./syntaxes/kaury.tmLanguage.json" }],
    "snippets": [{ "language": "kaury", "path": "./snippets.json" }]
  },
  "scripts": { "prepare": "node ../../scripts/construit.mjs && node -e \"require('fs').copyFileSync('../../dist/noyau.js','noyau.js')\"" }
}
