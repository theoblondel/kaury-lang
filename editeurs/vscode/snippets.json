{
  "Page": {
    "prefix": "page",
    "body": [
      "page \"/${1}\"",
      "  seo \"${2:Titre}\", \"${3:Description}\"",
      "  section ${4:accueil}, plein-ecran, centre",
      "    titre \"${5:Bonjour}\"",
      "    $0"
    ]
  },
  "Composant": {
    "prefix": "composant",
    "body": [
      "composant ${1:Carte} ${2:nom}",
      "  carte",
      "    texte ${2:nom}",
      "  style ombre douce, survol monte 4"
    ]
  },
  "Scène 3D": {
    "prefix": "scene",
    "body": [
      "scene plein-ecran",
      "  lumiere ${1|studio,douce,coucher-de-soleil,nuit,neon,jour,dramatique|}",
      "  objet ${2:nom} \"${3:modele.glb}\"",
      "    tourne au defilement",
      "    suit souris, doux",
      "  titre \"${4:Titre}\""
    ]
  },
  "Bouton": {
    "prefix": "bouton",
    "body": [
      "bouton \"${1:Texte}\" -> ${2:compteur += 1}"
    ]
  },
  "Pour": {
    "prefix": "pour",
    "body": [
      "pour ${1:item} dans ${2:liste}",
      "  $0"
    ]
  },
  "Formulaire": {
    "prefix": "formulaire",
    "body": [
      "formulaire -> envoye = vrai",
      "  champ email \"Ton e-mail\", type email, requis",
      "  bouton \"Envoyer\"",
      "si envoye",
      "  texte \"Merci !\""
    ]
  }
}