// Forge: the home page of a strength gym.
// Read as: a landing page for people choosing where to train, led by oversized type
// on a dark lifting floor, in off-black, bone and one acid green. Variance 8, motion 7, density 4.
site "Forge"
  colors accent #C8F03C, night #0C0D0A, coal #171915, bone #ECEAE2
  fonts "General Sans", "Tanker"
  lang "en"
  url "https://forge.example"
  style background night, color bone, radius 0, max-width 1320
  seo "Forge, strength gym in Lausanne", "A lifting floor with twelve racks, small coached groups and open gym from six in the morning. Your first session is free."

state yearly = false
state sent = false

let words = ["Strength", "Conditioning", "Weightlifting", "Open gym", "Mobility", "Sleds and carries"]

let training = [
  { n: "01", name: "Strength", text: "Squat, press, deadlift. Eight people per coach and a written programme, twelve weeks at a time.", when: "Mon, Wed, Fri\n06:30 and 18:30" },
  { n: "02", name: "Conditioning", text: "Sleds, rowers and loaded carries. Forty minutes that leave nothing in the tank.", when: "Tue, Thu\n12:15 and 19:00" },
  { n: "03", name: "Weightlifting", text: "Snatch, clean and jerk on four competition platforms, coached lift by lift.", when: "Tue, Thu 18:00\nSat 10:00" },
  { n: "04", name: "Open gym", text: "Your programme, our floor. Chalk is allowed, dropping the bar too.", when: "Every day\n06:00 to 22:00" }
]

let plans = [
  { name: "Drop in", month: 25, year: 25, per: "per visit", text: "The whole floor for the day. No contract, no card on file.", points: ["Open gym, 06:00 to 22:00", "Showers and towels", "Chalk on the house"], main: false },
  { name: "Unlimited", month: 119, year: 99, per: "per month", text: "Every class and open gym, seven days a week.", points: ["All coached classes", "Open gym, 06:00 to 22:00", "A programme review every twelve weeks"], main: true },
  { name: "Coached", month: 189, year: 159, per: "per month", text: "Unlimited, plus one hour alone with your coach each week.", points: ["Everything in Unlimited", "Weekly one to one", "Your own programme"], main: false }
]

style title
  weight 400, uppercase

style emphasis
  upright, color accent

style logo
  font "titles", size 30, weight 400, uppercase, tracking 1

style display
  font "titles", size 216, line-height 0.86, tracking 0
  tablet size 132
  mobile size 76

style heading
  font "titles", size 112, line-height 0.9, tracking 0
  tablet size 84
  mobile size 56

style lead
  size 20, line-height 1.5, width 540
  mobile size 18

style label
  uppercase, tracking 2, size 12, weight 600, color muted

style quiet
  background transparent, color bone, border 2 bone
  hover background bone, color night

style dark
  background night, color bone
  hover background coal

style tab
  background transparent, color bone, border 2 line, padding 9 20, size 15, weight 600
  selected background bone, color night, border 2 bone

style line
  padding 30 0, border-top 1 line, gap 24
  hover move 10 0

style shot
  grayscale
  hover grayscale 0

style plan
  background coal, padding 32, gap 14
  mobile padding 24

style best
  background accent, padding 32, gap 14
  mobile padding 24

animation rise, 0.9s, smooth
  from move 0 32
  to move 0 0

animation slide, 32s, loop, linear
  from move 0 0
  to move -50% 0

animation widen, scroll
  from grow 0.92, opacity 0.4
  to grow 1, opacity 1

component Coach name role photo about
  column gap 6
    image photo, about, cover, height 500, shot
      mobile height 420
    spacer 8
    subtitle name, level 3, font "titles", size 38, weight 400, uppercase, line-height 1
    text role, label

page "/"
  section header, sticky, padding 18 48
    mobile padding 14 20
    logo "Forge"
    links Training, Coaches, Prices
    button "Book a trial", small, to "#trial"

  section hero, background "hall.jpg", shade 0.94 bottom, color bone, padding 0 48 56
    mobile padding 0 20 40, shade 0.72
    spacer 250
    column gap 30, rise
      title "Strong is\n*built* here.", display
      row gap 32
        text "Twelve racks, small coached groups and a floor that opens at six. No mirrors, no machines lined up in a row.", lead
        row gap 12, margin 0 0 0 auto
          mobile margin 0
          button "Book a trial", large, to "#trial"
          button "See the prices", large, quiet, to "#prices"

  section band, background accent, padding 16 0, clip
    row no-wrap, slide, full-width, gap 40
      for w in words
        text w, font "titles", size 30, uppercase, line-height 1
        text "/", font "titles", size 30, line-height 1, opacity 0.45
      for w in words
        text w, font "titles", size 30, uppercase, line-height 1
        text "/", font "titles", size 30, line-height 1, opacity 0.45

  section training, padding 110 48 96
    mobile padding 64 20 56
    grid columns 1.4 1, gap 48
      tablet columns 1, gap 20
      title "Four ways\nunder the *bar*.", heading, level 2
      text "Pick one or mix them. Every class is capped, so a coach sees every lift you make.", lead, middle
    spacer 28
    column gap 0
      for t in training
        grid columns 0.25 1.1 1.7 0.8, line
          mobile columns 1, gap 8
          text t.n, color accent, weight 600
          subtitle t.name, level 3, font "titles", size 46, weight 400, uppercase, line-height 1
          text t.text, color muted
          text t.when, label, align right
            mobile align left

  section floor, padding 0 48 110
    mobile padding 0 20 64
    grid columns 1.7 1 1, gap 12
      tablet columns 1
      image "rack.jpg", "A power rack with a loaded barbell on the lifting floor", cover, height 460, shot, widen
        mobile height 280
      image "plate.jpg", "Close view of a forty-five pound plate on a barbell", cover, height 460, shot
        mobile height 280
      column gap 14, background coal, padding 32
        title "620 square metres of iron.", level 2, font "titles", size 54, line-height 0.95
        text "Twelve racks, four platforms, thirty metres of turf. One sauna, because you will want it.", color muted

  section coaches, padding 0 48 110
    mobile padding 0 20 64
    title "Coaches who\nstill *compete*.", heading, level 2
    spacer 24
    grid 3 columns, gap 20
      tablet columns 1, gap 36
      Coach "Ines Moreau", "Head coach, strength", "ines.jpg", "Ines Moreau, in profile on the lifting floor"
      column padding 72 0 0 0
        tablet padding 0
        Coach "Tom Keller", "Conditioning", "tom.jpg", "Tom Keller with a towel around his neck after a session"
      Coach "Karim Haddad", "Weightlifting", "karim.jpg", "Karim Haddad sitting between the machines"

  section prices, padding 0 48 110
    mobile padding 0 20 64
    row gap 20
      title "Simple *prices*.", heading, level 2
      row gap 8, margin 0 0 0 auto
        mobile margin 0
        button "Monthly", tab, selected (not yearly) -> yearly = false
        button "Yearly", tab, selected yearly -> yearly = true
    spacer 24
    grid columns 1 1.25 1, gap 16
      tablet columns 1
      for p in plans
        column plan, best p.main
          text p.name, uppercase, tracking 2, size 13, weight 600
          row gap 10
            text "{if yearly then p.year else p.month}", font "titles", size 104, line-height 0.9
            text "CHF\n{p.per}", size 14, line-height 1.3, margin auto 0 6 0
          text p.text
          column gap 0
            for point in p.points
              text point, padding 10 0, border-top 1 line, size 15
          if p.main
            button "Book a trial", dark, to "#trial", margin auto 0 0 0
          else
            button "Book a trial", quiet, to "#trial", margin auto 0 0 0
    text "Yearly prices are per month, paid once a year. Students and under 25: 20 percent off.", color muted, size 15

  section trial, background accent, padding 96 48
    mobile padding 56 20
    grid columns 1.15 1, gap 72
      tablet columns 1, gap 32
      column gap 20
        title "Your first\nsession is\non us.", heading, level 2
        text "Come an hour before a class. A coach shows you the floor, checks how you move and lifts with you.", lead
      column gap 16, middle
        if sent
          title "See you on the floor, {name}.", level 3, font "titles", size 48, line-height 0.95
          text "We write back today with a time."
        else
          form mail "hello@forge.example", subject "Trial session" -> sent = true
            field name "Ada Lovelace", required, label "Name"
            field email "ada@example.com", type email, required, label "Email"
            select goal "Get stronger", "Get fitter", "Learn the lifts", "Come back from an injury", label "What brings you in"
            button "Book a trial", large, dark

  footer padding 56 48 40, gap 32, direction column
    mobile padding 40 20 32
    grid 3 columns, gap 32
      tablet columns 1, gap 20
      column gap 4
        text "Forge", font "titles", size 30, uppercase, line-height 1
        text "Strength gym, Lausanne", color muted
      column gap 4
        text "Rue de Genève 88, 1004 Lausanne"
        text "Every day, 06:00 to 22:00", color muted
      column gap 4
        link "hello@forge.example" "mailto:hello@forge.example"
        link "021 555 01 88" "tel:+41215550188"
    divider
    text "Made with Kaury", color muted, size 14
