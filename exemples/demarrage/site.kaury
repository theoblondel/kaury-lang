// accueil.kaury — l'exemple de base : tout dans un fichier

site "Crush"
  couleurs rose #FF4F8B, creme #FFF4E8
  police "Clash Display"

etat compteur = 0

page "/"
  style fond creme

  section entete
    logo "crush.svg"
    liens Accueil, Gouts, Boutique

  section plein-ecran
    titre "Goûte la différence", taille 80, rose
    objet canette "crush.glb"
      tourne au defilement
      suit souris, doux

  section gouts
    grille 3 colonnes, espace 24
      carte "Fraise" "fraise.png"
      carte "Mangue" "mangue.png"
      carte "Citron" "citron.png"

  section
    bouton "J'aime {compteur}" -> compteur += 1
      style fond rose, coins 12
